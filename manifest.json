{
  "manifest_version": 3,
  "name": "抖音内容归档",
  "version": "0.1.10",
  "description": "按筛选条件归档抖音搜索页内容，或解析分享链接下载图文与视频。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "抖音内容归档",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["activeTab", "clipboardRead", "downloads", "scripting", "sidePanel", "storage", "tabs"],
  "host_permissions": [
    "https://www.douyin.com/*",
    "https://v.douyin.com/*",
    "https://*.douyinpic.com/*",
    "https://*.byteimg.com/*",
    "https://*.bytegecko.com/*"
  ]
}
